# syntax=docker/dockerfile:1
#
# Artwork of the Day — SLIM web image for a public deploy.
# Just the Flask app served by Waitress (~150 MB). The LLM runs in OpenAI's
# cloud, so there is no bundled model and no GPU needed — this is the image for
# Render / Cloud Run / Railway / Fly and any cheap container host.
#
#   docker build -f Dockerfile.web -t artwork-of-the-day-web .
#   docker run --rm -p 5000:5000 \
#     -e AOTD_LLM_BACKEND=openai -e OPENAI_API_KEY=sk-... \
#     -e AOTD_CONTACT=https://your/contact \
#     artwork-of-the-day-web
#   # open http://localhost:5000
#
# For the self-contained OFFLINE image (bundled Ollama + local model), use the
# other Dockerfile instead: `docker build -t artwork-of-the-day .`

FROM python:3.12-slim

# No .pyc files, unbuffered logs (so container logs stream in real time).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000 \
    AOTD_LLM_BACKEND=openai

WORKDIR /app

# Install deps first so the layer caches across code-only changes.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# App code (.dockerignore keeps .env, the model, venvs, and tooling out).
COPY . .

# Run as a non-root user.
RUN useradd --create-home --uid 10001 appuser \
 && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000

# Lightweight liveness check against the home page.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"5000\")}/').read()" || exit 1

# Waitress WSGI server (serve.py honors $PORT).
CMD ["python", "serve.py"]
