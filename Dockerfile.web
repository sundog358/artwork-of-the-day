# syntax=docker/dockerfile:1
#
# Artwork of the Day — slim web image (~150 MB).
# Just the Flask app served by Waitress. The app is pure Wikidata/SPARQL: no
# model, no GPU, no API key. Runs on Render / Cloud Run / Railway / Fly / any
# cheap container host.
#
#   docker build -f Dockerfile.web -t artwork-of-the-day .
#   docker run --rm -p 5000:5000 \
#     -e AOTD_CONTACT=https://your/contact \
#     artwork-of-the-day
#   # open http://localhost:5000

FROM python:3.12-slim

# No .pyc files, unbuffered logs (so container logs stream in real time).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000

WORKDIR /app

# Install deps first so the layer caches across code-only changes.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# App code (.dockerignore keeps .env, the model, venvs, and tooling out).
COPY . .

# Run as a non-root user.
RUN useradd --create-home --uid 10001 appuser \
 && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000

# Lightweight liveness check against the rate-limit-exempt /healthz endpoint.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"5000\")}/healthz').read()" || exit 1

# Waitress WSGI server (serve.py honors $PORT).
CMD ["python", "serve.py"]
