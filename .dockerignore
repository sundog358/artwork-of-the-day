# No secrets in the image (the app needs no API key), but never bake .env anyway.
.env
.env.*
!.env.example

# VCS / tooling
.git
.gitattributes
.gitignore
.github/
.claude/
.vscode/
.idea/

# Python caches / local venvs
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/

# Downloaded reference repos (not part of the app)
fastapiollamadocker/
fastapidocker/
reference/

# Dev-only validator + vendored schemas (not used at runtime)
validate_linked_art.py
requirements-dev.txt
linked_art_schema/

# Docker build context itself
Dockerfile.web
.dockerignore
