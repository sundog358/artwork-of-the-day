# Artwork of the Day — environment config (copy to .env; .env is gitignored)
#
# The app is pure Wikidata/SPARQL: no model, no API key, no per-token cost.
# Every variable below is OPTIONAL — the app runs with none of them set.

# --- Polite SPARQL/REST contact -------------------------------------------- #
# Sent in the User-Agent on Wikidata requests. Set to a real URL or email when
# you deploy (Wikimedia asks for a contact).
# AOTD_CONTACT=https://metahistorybook.com

# --- Rate limiting (per IP) ------------------------------------------------- #
# Protects the Wikidata-hitting endpoints from abuse. The home page (/) and the
# health check (/healthz) are always exempt. Format: Flask-Limiter strings
# joined by ";".
# AOTD_RATELIMIT_DEFAULT=1200 per hour;120 per minute
# AOTD_RATELIMIT_ENABLED=1
# AOTD_RATELIMIT_STORAGE=memory://   # use redis://… if you run more than one process

# --- In-process cache cap --------------------------------------------------- #
# Max entries per cache before oldest-first eviction.
# AOTD_CACHE_MAX=512

# --- Meta Museum ActivityStreams consumer ----------------------------------- #
# Daily consumes the Meta Museum (metamuseum.org) public IIIF Change Discovery
# feed as a distinct external consumer and keeps a small candidate pool of
# recently-changed paintings (see met_activity.py). The provider=met slice is
# the Metropolitan objects Meta Museum republishes. No API key. All optional.
# AOTD_MET_CONSUMER_ID=daily-metahistorybook-prod       # sent in UA + x-linked-art-consumer-id
# AOTD_MET_ACTIVITY_URL=https://www.metamuseum.org/api/activity/collection?provider=met
# AOTD_MET_STATE_PATH=met_candidates.json               # persisted pool + cursor
# AOTD_MET_MAX_PAGES=40    # bound the feed walk
# AOTD_MET_MAX_DEREF=80    # cap record dereferences per refresh
# AOTD_MET_MAX_POOL=500    # cap the persisted candidate pool
# Shared secret Meta Museum sends as `x-webhook-secret` on callback POSTs. When
# set, POSTs to /api/consumer/met/callback without a matching secret get 401.
# AOTD_MET_CALLBACK_TOKEN=
