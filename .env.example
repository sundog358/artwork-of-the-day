# Artwork of the Day — environment config (copy to .env; .env is gitignored)
#
# Article generation has two interchangeable backends. With NEITHER configured,
# the app still works — it serves the deterministic Wikidata fact summary (no
# model, no cost). Browsing and the Linked Art endpoints never need a model.

# --- Which backend writes the AI articles? --------------------------------- #
# "ollama" = a FREE local model (no API cost); "openai" = the hosted API.
# If unset, defaults to "openai" when OPENAI_API_KEY is present, else off.
AOTD_LLM_BACKEND=ollama

# --- Ollama (local, free) -------------------------------------------------- #
# Requires Ollama running with the model pulled (e.g. `ollama pull gemma4:latest`).
AOTD_OLLAMA_MODEL=gemma4:latest
# AOTD_OLLAMA_HOST=http://localhost:11434
# AOTD_OLLAMA_TIMEOUT=300            # seconds; local generation can be slow

# --- OpenAI (hosted, paid) ------------------------------------------------- #
# Only needed when AOTD_LLM_BACKEND=openai.
# OPENAI_API_KEY=sk-...
# AOTD_ARTICLE_MODEL=gpt-4o-mini

# --- Polite SPARQL/REST contact (optional) --------------------------------- #
# AOTD_CONTACT=https://github.com/your/repo

# --- Public-deployment knobs ----------------------------------------------- #
# Write the AI article automatically on every view (1), or only when the reader
# clicks "Write the full article" (default). Leave off for public sites so bots
# and idle views never spend tokens/CPU.
# AOTD_AUTO_GENERATE=0
#
# Per-IP rate limits. The generate limit guards the only expensive endpoint;
# the default covers normal browsing. Format: Flask-Limiter strings joined by ";".
# AOTD_RATELIMIT_DEFAULT=240 per hour;60 per minute
# AOTD_RATELIMIT_GENERATE=10 per hour;3 per minute
# AOTD_RATELIMIT_ENABLED=1
# AOTD_RATELIMIT_STORAGE=memory://   # use redis://… if you run more than one process
#
# Cap on each in-process cache (entries) before oldest-first eviction.
# AOTD_CACHE_MAX=512
