# Artwork of the Day — environment config (copy to .env; .env is gitignored)
#
# The app is pure Wikidata/SPARQL: no model, no API key, no per-token cost.
# Every variable below is OPTIONAL — the app runs with none of them set.

# --- Polite SPARQL/REST contact -------------------------------------------- #
# Sent in the User-Agent on Wikidata requests. Set to a real URL or email when
# you deploy (Wikimedia asks for a contact).
# AOTD_CONTACT=https://metahistorybook.com

# --- Rate limiting (per IP) ------------------------------------------------- #
# Protects the Wikidata-hitting endpoints from abuse. The home page (/) and the
# health check (/healthz) are always exempt. Format: Flask-Limiter strings
# joined by ";".
# AOTD_RATELIMIT_DEFAULT=1200 per hour;120 per minute
# AOTD_RATELIMIT_ENABLED=1
# AOTD_RATELIMIT_STORAGE=memory://   # use redis://… if you run more than one process

# --- In-process cache cap --------------------------------------------------- #
# Max entries per cache before oldest-first eviction.
# AOTD_CACHE_MAX=512
